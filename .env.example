# DERIV INTELLIGENCE — environment template
# Copy to .env.local for local development. NEVER commit real values.
# See docs/specs/16-environment-variables.md

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only — never expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Deriv API ---
